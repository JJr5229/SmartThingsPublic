# ------------------------------------------------------------------
# Veer Audit — environment configuration
# Copy this file to `.env.local` and fill in real values.
# Everything is OPTIONAL for a first local run: with no keys set, the
# audit still works, the proposal falls back to a template, and emails
# are printed to the server console instead of being sent.
# ------------------------------------------------------------------

# --- Performance auditing (Google PageSpeed Insights) ---
# Free key: https://developers.google.com/speed/docs/insights/v5/get-started
# Without it, performance falls back to a lightweight local check.
PAGESPEED_API_KEY=

# --- AI proposal generation (Anthropic / Claude) ---
# https://console.anthropic.com/  — used to write a custom proposal per lead.
# Without it, proposals use a good template built from the audit results.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Email delivery (Resend) ---
# https://resend.com  — simplest transactional email. Without it, emails
# are logged to the console so you can see exactly what would be sent.
RESEND_API_KEY=
# The "from" address must be on a domain you've verified in Resend.
EMAIL_FROM="Veer <hello@veersolutions.com>"
# Where lead notifications are sent (your inbox).
LEAD_NOTIFY_TO=info@veersolutions.com

# --- Branding / links used in the customer email ---
BOOKING_URL=https://calendly.com/your-veer-link
COMPANY_NAME=Veer
PUBLIC_BASE_URL=http://localhost:3000
